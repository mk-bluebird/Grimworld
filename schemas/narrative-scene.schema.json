{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GrimloreNarrativeScene",
  "$comment": "SOVEREIGN-ATTRIBUTION: bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7. Credit/workstream metadata only; not identity, consent, authorization, or execution evidence.",
  "type": "object",
  "required": [
    "schema_version",
    "scene_id",
    "prose",
    "annotations",
    "characters",
    "facts",
    "events",
    "initial_information",
    "acquisitions",
    "uses",
    "before",
    "causes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "scene_id": {
      "$ref": "#/$defs/id"
    },
    "prose": {
      "type": "string"
    },
    "annotations": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/annotation"
      }
    },
    "characters": {
      "$ref": "#/$defs/idList"
    },
    "facts": {
      "$ref": "#/$defs/idList"
    },
    "events": {
      "$ref": "#/$defs/idList"
    },
    "initial_information": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["character", "fact", "source_note"],
        "properties": {
          "character": {
            "$ref": "#/$defs/id"
          },
          "fact": {
            "$ref": "#/$defs/id"
          },
          "source_note": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "acquisitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/informationEvent"
      }
    },
    "uses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/informationEvent"
      }
    },
    "before": {
      "$ref": "#/$defs/edges"
    },
    "causes": {
      "$ref": "#/$defs/edges"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "idList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "span": {
      "type": "object",
      "required": ["start_utf16", "end_utf16", "quote"],
      "properties": {
        "start_utf16": {
          "type": "integer",
          "minimum": 0
        },
        "end_utf16": {
          "type": "integer",
          "minimum": 0
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "annotation": {
      "type": "object",
      "required": ["requirement", "status", "evidence", "rationale"],
      "properties": {
        "requirement": {
          "enum": [
            "viewpoint",
            "desire_or_pressure",
            "obstacle",
            "action_or_choice",
            "consequence",
            "continuing_question_or_resolution"
          ]
        },
        "status": {
          "enum": ["present", "absent", "unclear"]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "informationEvent": {
      "type": "object",
      "required": ["character", "fact", "event"],
      "properties": {
        "character": {
          "$ref": "#/$defs/id"
        },
        "fact": {
          "$ref": "#/$defs/id"
        },
        "event": {
          "$ref": "#/$defs/id"
        }
      },
      "additionalProperties": false
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": {
            "$ref": "#/$defs/id"
          },
          "to": {
            "$ref": "#/$defs/id"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
