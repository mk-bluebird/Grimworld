{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GrimloreCorrespondence",
  "$comment": "SOVEREIGN-ATTRIBUTION: bostrom18sd2ujv24ual9c9pshtxys6j8knh6xaead9ye7. Document credit and metadata only; not identity, consent, authorization, or execution evidence.",
  "type": "object",
  "required": [
    "id",
    "subject",
    "object",
    "scope",
    "preserve",
    "alter",
    "exceptions",
    "basis"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "object": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "const": "listed_attributes"
    },
    "preserve": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "alter": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/alteration"
      }
    },
    "mirror_axis": {
      "enum": [
        "character_sagittal",
        "image_vertical",
        "image_horizontal"
      ]
    },
    "exceptions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "basis": {
      "$ref": "#/$defs/basis"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "basis": {
      "enum": [
        "explicit_description",
        "derived_interpretation",
        "implementation_choice"
      ]
    },
    "alteration": {
      "type": "object",
      "required": [
        "key",
        "operation",
        "from",
        "to"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "enum": [
            "replace",
            "mirror"
          ]
        },
        "from": {},
        "to": {}
      },
      "additionalProperties": false
    },
    "ambiguity": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "state",
            "value",
            "basis"
          ],
          "properties": {
            "state": {
              "const": "known"
            },
            "value": {
              "type": [
                "object",
                "array",
                "string",
                "number",
                "boolean"
              ]
            },
            "basis": {
              "$ref": "#/$defs/basis"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "state",
            "reason",
            "basis"
          ],
          "properties": {
            "state": {
              "enum": [
                "unknown",
                "not_applicable",
                "intentionally_open"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "basis": {
              "$ref": "#/$defs/basis"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
